    "data",
    "api",
    "blocks",
    "postgres",
    "postgresql",
    "mysql",
    "dialect"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
